                                    <subviews>
                                        <box autoresizesSubviews="NO" fixedFrame="YES" borderType="line" title="RSRetry:" id="ju4-85-c9h">
                                            <rect key="frame" x="283" y="437" width="500" height="78"/>
                                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                            <view key="contentView" id="7ss-Nx-2V8">
                                                <rect key="frame" x="0.0" y="0.0" width="500" height="66"/>
                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                <subviews>
                                                    <textField focusRingType="none" verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" id="9eM-Qg-MUg">
                                                        <rect key="frame" x="15" y="17" width="478" height="48"/>
                                                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                        <textFieldCell key="cell" controlSize="mini" sendsActionOnEndEditing="YES" id="Pey-gQ-0Nt">
                                                            <font key="font" metaFont="system"/>
