                                                <action selector="enteredNewAddress:" target="494" id="1255"/>
                                            </connections>
                                        </textField>
                                        <box autoresizesSubviews="NO" fixedFrame="YES" borderType="line" title="Initialise address of Switch Decoder" id="1182">
                                            <rect key="frame" x="319" y="256" width="500" height="238"/>
                                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                            <view key="contentView" id="1ow-GE-TPH">
                                                <rect key="frame" x="0.0" y="0.0" width="500" height="226"/>
                                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                                <subviews>
                                                    <textField focusRingType="none" verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" fixedFrame="YES" id="1183">
                                                        <rect key="frame" x="11" y="40" width="476" height="176"/>
                                                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                                        <textFieldCell key="cell" controlSize="mini" sendsActionOnEndEditing="YES" id="1184">
                                                            <font key="font" metaFont="system"/>
                                                            <string key="title">Output(=switch, relays, ...) address should be in the range: 1...1024.  An output address will roughly be divided by 4 to calculate the Decoder's address (which is stored in CV1 and CV9), as well as the RS-Bus address (which is stored in CV10).  Uninitialised Switch decoders listen to loco address 6999. If the SET button is pushed, a PoM write message is send to this address, and CV1, CV9 and CV10 will be set.  Note that, as a result of the mapping between Switch and Decoder addresses, Output addresses will remapped to: 1, 5, 9, 13 ... 1021.</string>
                                                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                            <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                                                        </textFieldCell>
                                                    </textField>
                                                </subviews>
                                            </view>
                                        </box>
                                        <textField focusRingType="none" verticalHuggingPriority="750" fixedFrame="YES" id="1269">
                                            <rect key="frame" x="12" y="413" width="262" height="16"/>
                                            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                                            <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" sendsActionOnEndEditing="YES" alignment="right" title="From this switch address will be derived:" id="1270">
                                                <font key="font" metaFont="system"/>
                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
