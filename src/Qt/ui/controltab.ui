      <x>15</x>
      <y>21</y>
      <width>476</width>
      <height>111</height>
     </rect>
    </property>
    <property name="text">
     <string>It seems that different manufacturers use different conventions to code the address bits within DCC packets. Command Systems like the Roco 10764 starts with 0, whereas the Lenz LZV100 start with 1. In addition, the Lenz LZV100 seems to behave incorrect if the address is exactly 0, 64, 128 or 192. To compensate for this, a special Command System CV was added.</string>
    </property>
    <property name="alignment">
     <set>Qt::AlignLeft|Qt::AlignTop</set>
    </property>
    <property name="wordWrap">
     <bool>true</bool>
    </property>
