    <property name="text">
     <string>START selects the servo. Choose Min, Max or Speed.
Every change is written into the decoder directly and shown by the servo.

DONE ends the setting, CANCEL restores the values read before START.
MIDDLE sets the servo to 1500 µs; DEFAULTS restores the decoder defaults.</string>
    </property>
    <property name="alignment">
     <set>Qt::AlignLeft|Qt::AlignTop</set>
    </property>
